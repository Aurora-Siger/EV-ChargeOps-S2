DATABASE_URL=postgresql://evcharge:evcharge@localhost:5432/evchargeops
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
DISCORD_WEBHOOK_URL=
# Serviço de IA (Python)
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_TOKEN=

# --- SEMS+ (GoodWe) — login headless via Playwright ---
SEMS_ACCOUNT=seu-email@exemplo.com
SEMS_PASSWORD=sua-senha
SEMS_LOGIN_URL=https://semsplus.goodwe.com/#/login
SEMS_REGION=Americas
SEMS_GATEWAY=https://us-gateway.semsportal.com

# --- Dispositivo (carregador GoodWe HCA G2 da FIAP) ---
SEMS_SN=57000HPA247L0002
SEMS_STATION_ID=7f9af1fc-3a9a-4779-a4c0-ca6ec87bd93a
SEMS_PRODUCT_MODEL=GW7K-HCA-20

# --- Operação do coletor ---
SEMS_HEADLESS=true
SEMS_POLL_INTERVAL_MS=300000
SEMS_LOGIN_TIMEOUT_MS=60000
SEMS_DEBUG_DIR=/tmp/sems-debug
# Protege POST /admin/sems/* (relogin manual, troca de token, screenshots de debug)
ADMIN_KEY=troque-por-uma-chave-forte

# --- Primeiro usuario (login) --- criado por migrate.ts se ainda nao existir.
# Nao ha cadastro publico: sem estas variaveis, ninguem consegue entrar no app.
SUPER_ADMIN_EMAIL=admin@exemplo.com
SUPER_ADMIN_PASSWORD=troque-por-uma-senha-forte
SUPER_ADMIN_NAME=Administrador

# --- Asaas (Pix/boleto) --- sem ASAAS_API_KEY o app usa o gateway simulado.
# Webhook: cadastre https://SEU_DOMINIO/api/webhooks/asaas no Asaas (eventos de cobrança)
# com o mesmo token de ASAAS_WEBHOOK_TOKEN (gere com: openssl rand -hex 32).
# A chave começa com `$aact_`, mas shell/compose/Coolify expandem o `$`. Cole SEM o `$` inicial
# (ASAAS_API_KEY=aact_...): o app põe o `$` de volta.
# Num .env local, com o `$`, use aspas simples (ASAAS_API_KEY='$aact_...'); no Coolify, marque a variável como "Literal" ou escreva `$$aact_...`.
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=
