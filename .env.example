# Lido pelo docker-compose.yml (copie para .env). Sem as credenciais da SEMS+ o
# coletor não consegue logar, mas o app sobe com as recargas de demonstração.
OPENAI_API_KEY=
SEMS_ACCOUNT=
SEMS_PASSWORD=

# Primeiro login do app, criado na subida do server.
SUPER_ADMIN_EMAIL=admin@exemplo.com
SUPER_ADMIN_PASSWORD=troque-esta-senha

# Opcional: chave dos mapas da CARTO. Sem ela o mapa usa o acesso público.
VITE_CARTO_API_KEY=
